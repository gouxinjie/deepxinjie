# =============================================================
# 生产环境变量模板
# 使用方式：复制到服务器 /var/www/chat/.env 后按需填写
#   cp .env.example /var/www/chat/.env && chmod 600 /var/www/chat/.env
# 注意：本文件仅作模板，禁止写入任何真实密钥
# =============================================================

# ---------- 镜像仓库与版本 ----------
# 阿里云 ACR 个人实例专属域名（上海地域）
# 若 ECS 同为上海地域，可替换为控制台“访问凭证”页给出的专有网络地址，
# 形如 crpi-5ue84w8rjgqxg0s0-vpc.cn-shanghai.personal.cr.aliyuncs.com，走内网不占公网带宽
REGISTRY=crpi-5ue84w8rjgqxg0s0.cn-shanghai.personal.cr.aliyuncs.com
NAMESPACE=gouxinjie
# 每次发布由 GitHub Actions 自动改写为本次提交的 commit sha
IMAGE_TAG=latest

# ---------- 数据库（容器内网，主机名固定为 db）----------
DB_HOST=db
DB_USER=root
# 必填，无默认值，缺失后端启动即失败
DB_PASSWORD=
DB_NAME=chat_platform

# ---------- 鉴权 ----------
# 必填，建议使用 openssl rand -hex 32 生成
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 纯 HTTP 部署：Secure 必须为 false，否则浏览器不会保存 Cookie 导致登录态丢失
# 后续启用 HTTPS 时改为 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- 跨域 ----------
# 前后端同源部署，此项仅作兜底
CORS_ORIGINS=http://chat.gouxinjie.com

# ---------- 模型与联网搜索 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SEARCH_PROVIDER=
TAVILY_API_KEY=
